{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "design",
  "private": true,
  "description": "🎨 Design system foundation",
  "homepage": "https://github.com/nozomiishii/design#readme",
  "bugs": {
    "url": "https://github.com/nozomiishii/design/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nozomiishii/design.git"
  },
  "license": "MIT",
  "author": "Nozomi Ishii",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "postinstall": "postinstall",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@nozomiishii/commitlint-config": "2.3.1",
    "@nozomiishii/eslint-config": "2.3.1",
    "@nozomiishii/lefthook-config": "2.3.1",
    "@nozomiishii/postinstall": "2.3.1",
    "@nozomiishii/prettier-config": "2.3.1",
    "@nozomiishii/tsconfig": "2.3.1",
    "eslint": "10.9.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "error"
    }
  }
}
