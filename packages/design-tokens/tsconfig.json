{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@nozomiishii/tsconfig",

  "compilerOptions": {
    "incremental": true,

    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,

    "lib": ["ESNext"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
