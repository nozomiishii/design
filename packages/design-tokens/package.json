{
  "name": "@nozomiishii/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "デザイントークンの真実の源。Figma Variables と Tailwind CSS を DTCG 2025.10 で同期する",
  "license": "MIT",
  "author": "Nozomi Ishii",
  "type": "module",
  "exports": {
    "./tokens.css": "./generated/tokens.css",
    "./tailwind-theme.css": "./generated/tailwind-theme.css"
  },
  "scripts": {
    "build": "tz build && tsx src/generate-design-md.ts && pnpm --workspace-root exec prettier --write packages/design-tokens/generated packages/design-tokens/DESIGN.md",
    "import:figma": "tsx src/import-figma-export.ts",
    "lint": "tz lint && tsx src/tokens-check.ts",
    "test": "vitest",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@nozomiishii/tsconfig": "2.3.1",
    "@terrazzo/cli": "2.7.1",
    "@terrazzo/plugin-css": "2.7.1",
    "@terrazzo/plugin-tailwind": "2.7.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "zod": "4.5.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  }
}
